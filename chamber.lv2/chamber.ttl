        lv2:symbol "ominous" ;
        lv2:name "Ominous voice" ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:default 0 ;
        lv2:portProperty lv2:toggled
    ],
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 27 ;
        lv2:symbol "output" ;
        lv2:name "Output" ;
        lv2:minimum -24 ;
        lv2:maximum 12 ;
        lv2:default 0 ;
        units:unit units:db
    ],
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 28 ;
        lv2:symbol "bow_timbre_amount" ;
        lv2:name "Bow timbre amt" ;
        lv2:minimum -1 ;
        lv2:maximum 1 ;
        lv2:default 0
    ],
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 29 ;
        lv2:symbol "blow_meta_amount" ;
        lv2:name "Blow flow amt" ;
        lv2:minimum -1 ;
        lv2:maximum 1 ;
        lv2:default 0
    ],
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 30 ;
        lv2:symbol "blow_timbre_amount" ;
        lv2:name "Blow timbre amt" ;
        lv2:minimum -1 ;
        lv2:maximum 1 ;
        lv2:default 0
    ],
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 31 ;
        lv2:symbol "strike_meta_amount" ;
        lv2:name "Strk mallet amt" ;
        lv2:minimum -1 ;
        lv2:maximum 1 ;
        lv2:default 0
    ],
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 32 ;
        lv2:symbol "strike_timbre_amount" ;
        lv2:name "Strk timbre amt" ;
        lv2:minimum -1 ;
        lv2:maximum 1 ;
        lv2:default 0
    ],
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 33 ;
        lv2:symbol "geometry_amount" ;
        lv2:name "Geometry amt" ;
        lv2:minimum -1 ;
        lv2:maximum 1 ;
        lv2:default 0
    ],
